{
  "name": "crystal-atlas",
  "version": "1.6.0",
  "private": true,
  "description": "Interactive atlas of crystal-structure relationships",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-knowledge.ts && vp dev",
    "extract:propose": "node scripts/extract-literature.ts",
    "catalog:scan": "node scripts/catalog-literature.ts",
    "build:db": "node scripts/build-knowledge.ts",
    "test:db": "node scripts/build-knowledge.ts && node scripts/verify-knowledge.ts",
    "build": "node scripts/build-knowledge.ts && tsc -b && vp build && vp build --mode standalone",
    "preview": "vp preview",
    "test": "vp test run",
    "check": "vp check",
    "e2e": "playwright test",
    "verify": "vp check && vp test run && pnpm test:db && pnpm build && playwright test"
  },
  "dependencies": {
    "@ladybugdb/wasm-core": "0.22.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "~7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26"
  }
}
